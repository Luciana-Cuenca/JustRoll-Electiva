{
  "name": "justroll-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "dev": "ng serve",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "npm run build && node --test tests/app.test.mjs",
    "test:reference": "npm run build && node tests/reference-parity.mjs",
    "format": "prettier --write \"src/**/*.ts\" tests README.md",
    "format:check": "prettier --check \"src/**/*.ts\" tests README.md"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/router": "22.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "esbuild": "^0.28.2",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
